APP_NAME=SightIndex
ENVIRONMENT=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASIC_AUTH_USERNAME=
APP_BASIC_AUTH_PASSWORD=
LOCAL_TIMEZONE=UTC
DATABASE_URL=sqlite:///./sightindex.db
# Optional PostgreSQL Compose profile. Replace the password before enabling it,
# then set DATABASE_URL to postgresql+psycopg://sightindex:<password>@127.0.0.1:5432/sightindex.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sightindex
POSTGRES_USER=sightindex
POSTGRES_PASSWORD=change-me-before-use
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATA_DIR=data
MEDIA_RETENTION_DAYS=30
PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTO_CREATE_TABLES=true
FACE_MATCH_THRESHOLD=0.45
FACE_EMBEDDING_PROVIDER=opencv
# The development OpenCV extractor emits 32 x 32 vectors. Set 512 when switching
# to the InsightFace buffalo_l profile and rebuild existing face embeddings.
FACE_EMBEDDING_DIM=1024
FACE_EMBEDDING_DEVICE=
FACE_INSIGHTFACE_MODEL=buffalo_l
FACE_INSIGHTFACE_ROOT=
FACE_INSIGHTFACE_DET_SIZE=640
FACE_INSIGHTFACE_ALLOW_DOWNLOAD=false
FACE_RECOGNITION_ON_INGEST=false
FACE_FALLBACK_TO_FULL_IMAGE=false
FACE_MAX_LIBRARY_SCAN=5000
FACE_LIBRARY_CACHE_ENABLED=true
FACE_LIBRARY_CACHE_TTL_SECONDS=60
COUNT_DEDUP_SECONDS=60
PERSON_DETECTOR=hog
HOG_HIT_THRESHOLD=0.5
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=
YOLO_SERVICE_URL=http://127.0.0.1:19121
YOLO_SERVICE_CONFIDENCE=0.25
YOLO_SERVICE_IOU=0.5
YOLO_SERVICE_IMAGE_SIZE=1280
YOLO_SERVICE_MAX_DET=100
YOLO_SERVICE_TIMEOUT_SECONDS=120
FRAME_JPEG_QUALITY=95
THUMBNAIL_JPEG_QUALITY=92
PERSON_CROP_JPEG_QUALITY=96
PERSON_CROP_MIN_BBOX_WIDTH=0
PERSON_CROP_MIN_BBOX_HEIGHT=0
PERSON_CROP_MIN_CONFIDENCE=0.0
PERSON_CROP_UPSCALE_MIN_WIDTH=320
PERSON_CROP_UPSCALE_MIN_HEIGHT=720
PERSON_CROP_UPSCALE_MAX_FACTOR=2.0
PERSON_CROP_SHARPEN_AMOUNT=0.32
PERSON_CROP_SHARPEN_THRESHOLD=4
PERSON_CROP_PADDING_X_RATIO=0.24
PERSON_CROP_PADDING_TOP_RATIO=0.32
PERSON_CROP_PADDING_BOTTOM_RATIO=0.16
YOLO_SERVICE_PORT=19121
YOLO_SERVICE_HOST=127.0.0.1
YOLO_SERVICE_CONTAINER=sightindex-yolo-person
YOLO_SERVICE_IMAGE=
YOLO_SERVICE_MODEL_PATH=
YOLO_SERVICE_DEVICE=cuda:0
YOLO_SERVICE_WORKSPACE=
YOLO_SERVICE_AUTOSTART=false
YOLO_SERVICE_AUTOSTOP=false
STREAM_STORE_EMPTY_FRAMES=false
STREAM_AUTOSTART_RUNNING=true
MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default
# Keep this stable when the same logical Milvus database moves host/port.
MILVUS_NAMESPACE_ID=
MILVUS_COLLECTION_PREFIX=sightindex
# Keep this separate when switching CLIP/Qwen visual models; ReID and face
# collections continue using MILVUS_COLLECTION_PREFIX.
MILVUS_VISUAL_COLLECTION_PREFIX=
MILVUS_METRIC_TYPE=COSINE
MILVUS_TIMEOUT_SECONDS=3
MILVUS_FAILURE_COOLDOWN_SECONDS=60
# Used only by deploy/milvus/docker-compose.yml. Replace before enabling Milvus.
MINIO_ROOT_USER=sightindex
MINIO_ROOT_PASSWORD=change-me-before-use
EMBEDDING_PROVIDER=none
EMBEDDING_DIM=2560
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
# Generic CLIP/image-text vectors are not used by the production business-search path.
VISUAL_EMBEDDING_PROVIDER=none
VISUAL_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
VISUAL_EMBEDDING_DIM=512
VISUAL_EMBEDDING_DEVICE=
VISUAL_EMBEDDING_INSTRUCTION="Retrieve images that match the user query."
VISUAL_EMBEDDING_SERVICE_URL=
VISUAL_EMBEDDING_SERVICE_API_KEY=
VISUAL_EMBEDDING_SERVICE_TIMEOUT_SECONDS=15
VISUAL_EMBEDDING_SERVICE_FAILURE_COOLDOWN_SECONDS=60
VISUAL_EMBEDDING_MAX_CONCURRENCY=1
VISUAL_EMBEDDING_QUEUE_TIMEOUT_SECONDS=2
QWEN3_VL_EMBEDDING_REPO_DIR=
QWEN3_VL_EMBEDDING_PYTHONPATH=
QWEN3_VL_EMBEDDING_TORCH_DTYPE=bfloat16
QWEN3_VL_EMBEDDING_ATTN_IMPLEMENTATION=
VLM_PROVIDER=none
VLM_BASE_URL=http://127.0.0.1:8001/v1
VLM_API_KEY=
VLM_SERVICE_API_KEY=
VLM_MODEL=your-vlm-model
VLM_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=256
VLM_TEMPERATURE=0.1
VLM_CAPTION_ON_INDEX=false
VLM_STRUCTURED_ON_INGEST=false
VLM_STRUCTURED_MAX_TOKENS=1200
# Attributes below this model confidence are stored as unknown instead of a
# potentially misleading concrete value.
VLM_STRUCTURED_MIN_CONFIDENCE=0.55
VLM_RERANK_ENABLED=false
VLM_RERANK_SERVICE_URL=
VLM_RERANK_SERVICE_API_KEY=
VLM_RERANK_PROVIDER=none
VLM_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
VLM_RERANK_DEVICE=
VLM_RERANK_CANDIDATE_LIMIT=30
VLM_RERANK_MAX_WORKERS=8
VLM_RERANK_MIN_SCORE=0.0
VLM_RERANK_TIMEOUT_SECONDS=180
EMBEDDING_RERANK_ENABLED=false
EMBEDDING_RERANK_CANDIDATE_LIMIT=50
EMBEDDING_RERANK_MAX_WORKERS=8
EMBEDDING_RERANK_WEIGHT=0.35
VLM_RERANK_WEIGHT=0.65
VECTOR_INDEX_ON_INGEST=false
QWEN3_VL_RERANKER_PORT=18022
QWEN3_VL_RERANKER_IMAGE=
PERSON_TRAJECTORY_VECTOR_ENABLED=false
PERSON_TRAJECTORY_VECTOR_MIN_SCORE=0.72
PERSON_TRAJECTORY_FACE_SEED_VECTOR_MIN_SCORE=0.40
PERSON_TRAJECTORY_VECTOR_SEED_LIMIT=3
PERSON_TRAJECTORY_VECTOR_TOP_K=40
PERSON_TRAJECTORY_VECTOR_MAX_SECONDS=8
PERSON_TRAJECTORY_VECTOR_EMBEDDING_TIMEOUT_SECONDS=5
PERSON_TRAJECTORY_REID_MAX_SECONDS=8

REID_ENABLED=false
REID_SERVICE_URL=http://127.0.0.1:18031
REID_SERVICE_API_KEY=
REID_SERVICE_PORT=18031
REID_CHECKPOINT_DIR=data/models/sapiensid_wb12m
REID_MODEL=sapiensid_wb12m
# Composite SHA-256 of backbone/config + pose/DFA aligner assets; match /ready exactly.
REID_CHECKPOINT_REVISION=sha256:6302aa80abdd5a3fba51b4d892dfdae515cfa0ca5f3762031890c63e6a688971
REID_EMBEDDING_DIM=4096
REID_PREPROCESS_VERSION=squarepad-v1
REID_WARMUP_ON_START=true
REID_INDEX_ON_INGEST=true
REID_SEARCH_TOP_K=20
REID_CANDIDATE_POOL_MAX=5000
REID_MIN_SCORE=0.5
REID_ATTRIBUTE_FILTER_ENABLED=true
REID_ATTRIBUTE_MIN_CONFIDENCE=0.75
REID_ATTRIBUTE_HARD_CONFLICTS=2
REID_ATTRIBUTE_HARD_CONFIDENCE=1.6
REID_ATTRIBUTE_FULL_WEIGHT=3.0
REID_ATTRIBUTE_HARD_FILTER_WINDOW_HOURS=4.0
REID_ATTRIBUTE_WEIGHT=0.04
REID_ATTRIBUTE_ANALYZE_UPLOAD=true
REID_ATTRIBUTE_ENRICH_QUERY_CROP=true
REID_FACE_PRIORITY_ENABLED=true
REID_FACE_CANDIDATE_LIMIT=12
REID_FACE_MIN_QUALITY=0.55
REID_FACE_STRONG_RELIABILITY=0.70
REID_FACE_HARD_REJECT_THRESHOLD=0.30
REID_GALLERY_SIZE=8
REID_GALLERY_TOP_K=3
REID_QUERY_TRACKLET_FRAMES=6
REID_QUERY_TRACKLET_WINDOW_SECONDS=30
REID_QUERY_TRACKLET_IDENTITY_THRESHOLD=0.78
REID_QUERY_TRACKLET_CANDIDATE_LIMIT=80
