SIGHTINDEX_IMAGE=sightindex:reviewed-release
POSTGRES_IMAGE=postgres:15-bookworm
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.14
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z
MILVUS_IMAGE=milvusdb/milvus:v2.5.0
MEDIA_DIR=/data/sightindex-bj-test/media
MODEL_DIR=/data/sightindex-bj-test/models
CACHE_DIR=/data/sightindex-bj-test/cache
API_BIND=127.0.0.1
API_PORT=18030
UPLOAD_IMAGE_MAX_BYTES=20971520
UPLOAD_VIDEO_MAX_BYTES=134217728
UPLOAD_IMAGE_MAX_PIXELS=25000000
PUBLIC_BASE_URL=http://127.0.0.1:18030
APP_BASIC_AUTH_USERNAME=sightindex
APP_BASIC_AUTH_PASSWORD=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
REID_SERVICE_API_KEY=
REID_ENABLED=false
LINE_CROSSING_TRACK_IDLE_SECONDS=6
LINE_CROSSING_TRACK_MAX_MISSED_FRAMES=2
REID_CHECKPOINT_REVISION=sha256:6302aa80abdd5a3fba51b4d892dfdae515cfa0ca5f3762031890c63e6a688971
QWEN_EMBEDDING_IMAGE=sightindex-embedding:reviewed-release
QWEN_EMBEDDING_MODEL_DIR=/data/sightindex-bj-test/models/qwen3-vl-embedding-2b-c73fa9ca
QWEN_EMBEDDING_API_KEY=
QWEN_VISUAL_COLLECTION_PREFIX=sightindex_bj_test_qwen3vl2b_768p_v1
SEMANTIC_SEARCH_ENABLED=false
# embedding-external stack: point the API at an existing service instead of
# the bundled Qwen3-VL container (contract: POST {url}/api/embeddings/visual)
EXTERNAL_EMBEDDING_URL=
EXTERNAL_EMBEDDING_API_KEY=
EXTERNAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
EXTERNAL_EMBEDDING_DIM=2048
# vlm stack: structured-attribute analysis via an existing OpenAI-compatible
# vision model (Ollama: http://<host>:11434/v1, model e.g. qwen3-vl:4b;
# Ollama ignores the key, vLLM may require one)
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=ollama
VLM_TIMEOUT_SECONDS=120
VLM_STRUCTURED_BACKGROUND=true
