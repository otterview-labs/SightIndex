SIGHTINDEX_IMAGE=sightindex:reviewed-release
# For a second instance, use its own project, ports, MEDIA_DIR and CACHE_DIR.
# An existing accepted deployment root cannot be retargeted to another project.
COMPOSE_PROJECT_NAME=sightindex-bj-test
POSTGRES_IMAGE=postgres:15-bookworm
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.14
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z
MILVUS_IMAGE=milvusdb/milvus:v2.5.0
MEDIA_DIR=/data/sightindex-bj-test/media
MODEL_DIR=/data/sightindex-bj-test/models
CACHE_DIR=/data/sightindex-bj-test/cache
API_BIND=127.0.0.1
API_PORT=18030
UPLOAD_IMAGE_MAX_BYTES=20971520
UPLOAD_VIDEO_MAX_BYTES=134217728
UPLOAD_IMAGE_MAX_PIXELS=25000000
# Opt in for new uploads only; no historical video is scanned or rewritten.
# ffmpeg/ffprobe are installed in the API image, not required on the container host.
VIDEO_PREPARATION_ENABLED=false
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_FFPROBE_BINARY=ffprobe
VIDEO_PREPARATION_TIMEOUT_SECONDS=120
VIDEO_PROBE_TIMEOUT_SECONDS=10
VIDEO_PREPARATION_MAX_DURATION_SECONDS=300
VIDEO_PREPARATION_MAX_PIXELS=2073600
VIDEO_PREPARATION_MAX_OUTPUT_BYTES=134217728
VIDEO_PREPARATION_MIN_FREE_BYTES=536870912
VIDEO_PREPARATION_THREADS=2
VIDEO_PREPARATION_INCLUDE_AUDIO=false
PUBLIC_BASE_URL=http://127.0.0.1:18030
APP_BASIC_AUTH_USERNAME=sightindex
APP_BASIC_AUTH_PASSWORD=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
REID_SERVICE_API_KEY=
REID_ENABLED=false
LINE_CROSSING_TRACK_IDLE_SECONDS=6
LINE_CROSSING_TRACK_MAX_MISSED_FRAMES=2
# Bounded native-ROI samples per local position visit; not an identity threshold.
PERSON_CROP_VISIT_MAX_SAMPLES=3
PERSON_CROP_VISIT_SAMPLE_INTERVAL_SECONDS=2.0
PERSON_CROP_VISIT_QUALITY_IMPROVEMENT_RATIO=0.15
# Leave both absent until a fit is validated for these cameras and gallery.
# REID_CROSS_CAMERA_CALIBRATION_COEF=<finite coefficient>
# REID_CROSS_CAMERA_CALIBRATION_INTERCEPT=<finite intercept>
FACE_RECOGNITION_ON_INGEST=false
REID_CHECKPOINT_REVISION=sha256:6302aa80abdd5a3fba51b4d892dfdae515cfa0ca5f3762031890c63e6a688971
# Optional existing OpenAI-compatible VLM endpoint. No local VLM service is started.
VLM_PROVIDER=none
VLM_BASE_URL=http://127.0.0.1:8001/v1
VLM_MODEL=Qwen3.6-27B
VLM_API_KEY=
VLM_SERVICE_API_KEY=
VLM_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=256
VLM_TEMPERATURE=0.1
VLM_CAPTION_ON_INDEX=false
VLM_STRUCTURED_ON_INGEST=false
VLM_STRUCTURED_BACKGROUND=false
VLM_STRUCTURED_MAX_TOKENS=1200
VLM_STRUCTURED_MIN_CONFIDENCE=0.55
QWEN_EMBEDDING_IMAGE=sightindex-embedding:reviewed-release
QWEN_EMBEDDING_MODEL_DIR=/data/sightindex-bj-test/models/qwen3-vl-embedding-2b-c73fa9ca
QWEN_EMBEDDING_API_KEY=
QWEN_VISUAL_COLLECTION_PREFIX=sightindex_bj_test_qwen3vl2b_768p_v1
# Selecting the semantic overlay does not enable it; explicitly opt in after backfill.
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_SEARCH_MIN_SCORE=0.25
SEMANTIC_SEARCH_MAX_SCOPE=10000
