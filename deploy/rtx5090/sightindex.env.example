# RTX 5090 single-host profile. Copy to /opt/sightindex/.env as
# root:sightindex with mode 0640,
# and review every value before deployment. Keep this to simple KEY=value
# assignments; quote spaces, and do not use shell substitutions or commands.

APP_NAME=SightIndex
ENVIRONMENT=production
APP_HOST=127.0.0.1
APP_PORT=8000
LOCAL_TIMEZONE=UTC
# SQLite keeps the single-host profile compact. Prefer PostgreSQL for sustained
# concurrent ingest or an installation with an existing database platform.
DATABASE_URL=sqlite:////var/lib/sightindex/db/sightindex.db
DATA_DIR=/var/lib/sightindex/data
PUBLIC_BASE_URL=https://sightindex.example.com
AUTO_CREATE_TABLES=true
APP_BASIC_AUTH_USERNAME=
APP_BASIC_AUTH_PASSWORD=

# Milvus runs locally through deploy/milvus/docker-compose.yml. Replace both
# placeholder secrets before running the deployment wrapper.
MILVUS_ENABLED=true
MILVUS_BIND=127.0.0.1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DB=default
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_NAMESPACE_ID=sightindex-rtx5090
MILVUS_COLLECTION_PREFIX=sightindex
MILVUS_VISUAL_COLLECTION_PREFIX=
MILVUS_METRIC_TYPE=COSINE
MILVUS_TIMEOUT_SECONDS=3
MILVUS_FLUSH_TIMEOUT_SECONDS=60
MINIO_ROOT_USER=sightindex
MINIO_ROOT_PASSWORD=replace-with-random-secret

# In-process person detector. Model files are operator-managed runtime assets.
PERSON_DETECTOR=yolo
YOLO_MODEL=/var/lib/sightindex/models/yolo11n.pt
YOLO_DEVICE=cuda:0
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=1280
FRAME_JPEG_QUALITY=95
THUMBNAIL_JPEG_QUALITY=92
PERSON_CROP_JPEG_QUALITY=96
PERSON_CROP_MIN_CONFIDENCE=0.70
PERSON_CROP_UPSCALE_MIN_WIDTH=320
PERSON_CROP_UPSCALE_MIN_HEIGHT=720
PERSON_CROP_UPSCALE_MAX_FACTOR=2.0
PERSON_CROP_SHARPEN_AMOUNT=0.32
PERSON_CROP_SHARPEN_THRESHOLD=4
PERSON_CROP_PADDING_X_RATIO=0.24
PERSON_CROP_PADDING_TOP_RATIO=0.55
PERSON_CROP_PADDING_BOTTOM_RATIO=0.16
STREAM_AUTOSTART_RUNNING=true
STREAM_STORE_EMPTY_FRAMES=false

# InsightFace face evidence. Seed buffalo_l before deployment; request-time
# downloads stay disabled.
FACE_EMBEDDING_PROVIDER=insightface
FACE_EMBEDDING_DIM=512
FACE_EMBEDDING_DEVICE=cuda:0
FACE_INSIGHTFACE_MODEL=buffalo_l
FACE_INSIGHTFACE_ROOT=/var/lib/sightindex/models/insightface
FACE_INSIGHTFACE_DET_SIZE=640
FACE_INSIGHTFACE_ALLOW_DOWNLOAD=false
FACE_RECOGNITION_ON_INGEST=false
FACE_FALLBACK_TO_FULL_IMAGE=false
FACE_MATCH_THRESHOLD=0.45

# SapiensID body embedding service. Its upstream code and weights are subject
# to non-commercial terms; review THIRD_PARTY_NOTICES.md before enabling it.
REID_ENABLED=true
REID_SERVICE_HOST=127.0.0.1
REID_SERVICE_URL=http://127.0.0.1:18031
REID_SERVICE_PORT=18031
REID_SERVICE_API_KEY=
REID_CHECKPOINT_DIR=/var/lib/sightindex/models/sapiensid_wb12m
REID_POSE_WEIGHTS=/var/lib/sightindex/.cache/yolov8n-pose.pt
REID_DEVICE=cuda:0
REID_MODEL=sapiensid_wb12m
REID_CHECKPOINT_REVISION=sha256:6302aa80abdd5a3fba51b4d892dfdae515cfa0ca5f3762031890c63e6a688971
REID_EMBEDDING_DIM=4096
REID_PREPROCESS_VERSION=squarepad-v1
REID_WARMUP_ON_START=true
REID_INDEX_ON_INGEST=true
REID_MIN_SCORE=0.50
REID_MIN_SCORE_CROSS_CAMERA=0.45
REID_CHANCE_CEILING=0.44
REID_CAMERA_QUOTA=3
REID_CANDIDATE_POOL_MAX=5000
REID_GALLERY_SIZE=8
REID_GALLERY_TOP_K=3
REID_QUERY_TRACKLET_FRAMES=6
REID_QUERY_TRACKLET_WINDOW_SECONDS=30
REID_QUERY_TRACKLET_IDENTITY_THRESHOLD=0.78
REID_QUERY_TRACKLET_CANDIDATE_LIMIT=80
REID_ATTRIBUTE_FILTER_ENABLED=true
REID_ATTRIBUTE_MIN_CONFIDENCE=0.75
REID_ATTRIBUTE_HARD_CONFLICTS=2
REID_ATTRIBUTE_HARD_CONFIDENCE=1.60
REID_ATTRIBUTE_FULL_WEIGHT=3.0
REID_ATTRIBUTE_HARD_FILTER_WINDOW_HOURS=4.0
REID_ATTRIBUTE_WEIGHT=0.04
REID_ATTRIBUTE_ANALYZE_UPLOAD=true
REID_ATTRIBUTE_ENRICH_QUERY_CROP=true
REID_FACE_PRIORITY_ENABLED=true
REID_FACE_CANDIDATE_LIMIT=12
REID_FACE_MIN_QUALITY=0.55
REID_FACE_STRONG_RELIABILITY=0.70
REID_FACE_HARD_REJECT_THRESHOLD=0.30

# Optional OpenAI-compatible VLM. Leave disabled until the endpoint, model,
# and credentials are configured. Synchronous ingest remains off so an
# unavailable model cannot block camera capture.
VLM_PROVIDER=none
VLM_BASE_URL=http://127.0.0.1:8001/v1
VLM_MODEL=your-vlm-model
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=120
VLM_STRUCTURED_MAX_TOKENS=1200
VLM_STRUCTURED_MIN_CONFIDENCE=0.55
VLM_STRUCTURED_ON_INGEST=false
VLM_CAPTION_ON_INDEX=false

# Generic text/image retrieval is separate from the ReID decision path.
VISUAL_EMBEDDING_PROVIDER=none
VISUAL_EMBEDDING_SERVICE_API_KEY=
VECTOR_INDEX_ON_INGEST=false
EMBEDDING_RERANK_ENABLED=false
VLM_RERANK_ENABLED=false

# The wrapper installs CUDA PyTorch only when it is absent. Override this URL
# when the target driver requires a different official wheel set.
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
