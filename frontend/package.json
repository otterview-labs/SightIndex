{
  "name": "sightindex-frontend",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ${OPENAPI_SRC:-http://127.0.0.1:8000/openapi.json} -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs"
  },
  "type": "module",
  "private": "true",
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
